# Template for .env - copy it and fill in the values:  cp .env.example .env

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=
# https://eu.api.smith.langchain.com for EU accounts
LANGSMITH_ENDPOINT=

# OpenAI (embeddings)
OPENAI_API_KEY=

# OpenRouter (chat models for the agent)
OPENROUTER_API_KEY=

# Postgres (pgvector) - must match docker-compose.yml
DATABASE_URL=
